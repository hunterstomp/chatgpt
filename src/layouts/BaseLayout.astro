---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Quentin Little - UX Designer & Prototyper. Enterprise UX, accessibility, and design systems.",
  image = "/assets/og-default.webp",
  canonical 
} = Astro.props;

const canonicalUrl = canonical ? new URL(canonical, Astro.site) : Astro.url;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <!-- Preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/assets/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/permanent-marker.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Q10UX Tokens -->
    <link rel="stylesheet" href="/src/Q10UX_Command_Pack/styleguide/tokens.css" />
  </head>
  <body>
    <!-- Skip Link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Header -->
    <header class="site-header">
      <nav class="nav-main">
        <a href="/" class="nav-logo">
          <img src="/assets/logos/q10ux-logo.webp" alt="Q10UX" width="120" height="40" />
        </a>
        <ul class="nav-menu">
          <li><a href="/" class="nav-link">HOME</a></li>
          <li><a href="/case-studies" class="nav-link">CASE STUDIES</a></li>
          <li><a href="/about" class="nav-link">ABOUT</a></li>
          <li><a href="/contact" class="nav-link">CONTACT</a></li>
        </ul>
        <a href="/assets/Quentin-Little-Resume.pdf" class="btn btn--secondary" download>
          Resume
        </a>
      </nav>
    </header>
    
    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-brand">
          <img src="/assets/logos/q10ux-logo.webp" alt="Q10UX" width="100" height="33" />
          <p>UX Designer & Prototyper</p>
        </div>
        <div class="footer-links">
          <a href="/case-studies" class="footer-link">Case Studies</a>
          <a href="/about" class="footer-link">About</a>
          <a href="/contact" class="footer-link">Contact</a>
        </div>
        <div class="footer-social">
          <a href="https://linkedin.com/in/quentinlittle" class="social-link" aria-label="LinkedIn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://github.com/quentstyle" class="social-link" aria-label="GitHub">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2025 Quentin Little. All rights reserved.</p>
      </div>
    </footer>
    
    <style>
      /* Skip Link */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: var(--q-brand-500);
        color: var(--q-ink);
        padding: 8px;
        text-decoration: none;
        border-radius: var(--q-radius-sm);
        z-index: 1000;
        transition: top 0.3s;
      }
      
      .skip-link:focus {
        top: 6px;
      }
      
      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        background: var(--q-surface);
        border-bottom: 1px solid var(--q-border);
        z-index: 100;
        backdrop-filter: blur(10px);
      }
      
      .nav-main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }
      
      .nav-logo img {
        height: 40px;
        width: auto;
      }
      
      .nav-menu {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 2rem;
      }
      
      .nav-link {
        color: #E8EAED;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.125rem;
        font-family: 'Roboto Condensed', sans-serif;
        transition: color 0.2s;
      }
      
      .nav-link:hover {
        color: var(--q-brand-500);
      }
      
      /* Footer */
      .site-footer {
        background: var(--q-surface);
        border-top: 1px solid var(--q-border);
        margin-top: 4rem;
      }
      
      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 2rem 2rem;
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 3rem;
        align-items: start;
      }
      
      .footer-brand p {
        margin: 0.5rem 0 0;
        color: #A0A0A0;
      }
      
      .footer-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      
      .footer-link {
        color: #E8EAED;
        text-decoration: none;
        transition: color 0.2s;
      }
      
      .footer-link:hover {
        color: var(--q-brand-500);
      }
      
      .footer-social {
        display: flex;
        gap: 1rem;
      }
      
      .social-link {
        color: #A0A0A0;
        transition: color 0.2s;
      }
      
      .social-link:hover {
        color: var(--q-brand-500);
      }
      
      .footer-bottom {
        border-top: 1px solid var(--q-border);
        padding: 1.5rem 2rem;
        text-align: center;
        color: #A0A0A0;
      }
      
      /* Responsive */
      @media (max-width: 768px) {
        .nav-main {
          padding: 1rem;
          flex-wrap: wrap;
        }
        
        .nav-menu {
          order: 3;
          width: 100%;
          justify-content: center;
          margin-top: 1rem;
        }
        
        .footer-content {
          grid-template-columns: 1fr;
          text-align: center;
          gap: 2rem;
        }
      }
    </style>
  </body>
</html>
