---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTransitions from '../../components/PageTransitions.astro';
import { absUrl } from "@/lib/absUrl";

const items = (await Astro.glob('./*.md*')).map(p => {
  const fm = p.frontmatter ?? {};
  const first = Array.isArray(fm.gallery) && fm.gallery[0]?.src;
  return {
    ...fm,
    href: `/case-studies/${fm.slug || p.file.replace(/\.mdx?$/,'')}/`,
    thumb: absUrl(fm.thumb || first),
  };
});
---

<BaseLayout
  title="Case Studies | Q10UX Portfolio"
  description="Explore a selection of enterprise UX case studies from Disney, AT&T, AtmosFX, and Microsoft, showcasing impactful design solutions."
>
  <PageTransitions />
  
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">Case Studies</h1>
        <p class="hero-subtitle">
          A selection of impactful UX projects across enterprise, consumer, and emerging technologies
        </p>
      </div>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="case-studies">
    <div class="container">
      <div class="case-studies-grid">
        {items.map(item => (
          <a href={item.href} class="case-study-card">
            <div class="case-study-image">
              <img 
                src={item.thumb || '/assets/placeholders/case-study-placeholder.svg'} 
                alt={item.title || 'Case Study'} 
                loading="lazy"
              />
            </div>
            <div class="case-study-content">
              <div class="case-study-client">{item.client || 'Client'}</div>
              <h3 class="case-study-title">{item.title || 'Case Study'}</h3>
              <p class="case-study-summary">{item.summary || ''}</p>
              {Array.isArray(item.tags) && item.tags.length > 0 && (
                <div class="case-study-tags">
                  {item.tags.slice(0, 3).map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">Ready to work together?</h2>
      <p class="cta-description">
        Let's discuss your project and how I can help bring your vision to life.
      </p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn--primary">Start a Conversation</a>
        <a href="/about" class="btn btn--secondary">Learn More About Me</a>
      </div>
    </div>
  </section>

  <style>
    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    /* Hero Section */
    .hero {
      min-height: 50vh;
      display: flex;
      align-items: center;
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      color: white;
    }
    
    .hero-content {
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
    }
    
    .hero-title {
      font-size: 3.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #ffffff;
    }
    
    .hero-subtitle {
      font-size: 1.25rem;
      color: #cccccc;
      line-height: 1.6;
    }
    
    /* Case Studies Section */
    .case-studies {
      padding: 6rem 0;
      background: #f8f9fa;
    }
    
    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 2rem;
    }
    
    .case-study-card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      text-decoration: none;
      color: inherit;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .case-study-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .case-study-image {
      height: 250px;
      overflow: hidden;
    }
    
    .case-study-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .case-study-content {
      padding: 2rem;
    }
    
    .case-study-client {
      font-size: 0.875rem;
      color: #666;
      margin-bottom: 0.5rem;
      font-weight: 500;
    }
    
    .case-study-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #333;
      line-height: 1.3;
    }
    
    .case-study-summary {
      font-size: 1rem;
      color: #666;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    
    .case-study-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .tag {
      font-size: 0.75rem;
      padding: 0.25rem 0.75rem;
      background: #e9ecef;
      color: #495057;
      border-radius: 20px;
      font-weight: 500;
    }
    
    /* CTA Section */
    .cta-section {
      padding: 6rem 0;
      background: #1a1a1a;
      color: white;
      text-align: center;
    }
    
    .cta-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    
    .cta-description {
      font-size: 1.125rem;
      color: #cccccc;
      margin-bottom: 2rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    /* Buttons */
    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      border: 2px solid transparent;
    }
    
    .btn--primary {
      background: #4a9eff;
      color: white;
    }
    
    .btn--primary:hover {
      background: #3a8eef;
      transform: translateY(-2px);
    }
    
    .btn--secondary {
      background: transparent;
      color: #4a9eff;
      border-color: #4a9eff;
    }
    
    .btn--secondary:hover {
      background: #4a9eff;
      color: white;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .hero-title {
        font-size: 2.5rem;
      }
      
      .case-studies-grid {
        grid-template-columns: 1fr;
      }
      
      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }
    }
  </style>
</BaseLayout>
