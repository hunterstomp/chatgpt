  <script>
    // Intersection Observer for scroll-triggered accordion opening
    document.addEventListener('DOMContentLoaded', function() {
      const accordionItems = document.querySelectorAll('.process-accordion-item');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const accordionButton = entry.target.querySelector('.accordion-button');
            if (accordionButton && accordionButton.classList.contains('collapsed')) {
              // Add a small delay for better UX
              setTimeout(() => {
                accordionButton.click();
              }, 500);
            }
            // Unobserve after triggering to prevent multiple triggers
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.3,
        rootMargin: '0px 0px -100px 0px'
      });

      accordionItems.forEach(item => {
        observer.observe(item);
      });

      // Smooth accordion animations
      const accordionButtons = document.querySelectorAll('.accordion-button');
      accordionButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          const targetId = this.getAttribute('data-bs-target');
          const targetElement = document.querySelector(targetId);
          
          if (targetElement) {
            // Add smooth transition
            targetElement.style.transition = 'all 0.3s ease';
          }
        });
      });
    });
  </script>
</BaseLayout>
