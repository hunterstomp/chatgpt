---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import HeroHeading from '../components/HeroHeading.astro';
import PageTransitions from '../components/PageTransitions.astro';
import FeaturedCaseStudies from '../components/FeaturedCaseStudies.astro';

// Hero images for the carousel
const heroImages = [
  "/assets/hero/2015-gates-annual-letter-2-2000x1068.png",
  "/assets/hero/afx-web-exploration1-58-1036x777.webp",
  "/assets/hero/annual-newsletter-hero.webp",
  "/assets/hero/avatar.png",
  "/assets/hero/ecommerce-redesign-hero.webp",
  "/assets/hero/hero-bmgf-1276x1754.jpg"
];
---

<BaseLayout 
  title="Quentin Little - UX Designer & Prototyper"
  description="Enterprise UX designer specializing in accessibility, design systems, and user research. Case studies from Disney, AT&T, AtmosFX, and Microsoft."
>
  <PageTransitions />
  
  <!-- Hero Section with Carousel -->
  <HeroCarousel images={heroImages} height="80vh">
    <HeroHeading 
      title="Better Experiences. Real Results."
      subtitle="UX Designer crafting impactful digital solutions"
      showCTAs={true}
    />
  </HeroCarousel>

  <!-- Featured Case Studies -->
  <FeaturedCaseStudies />

  <!-- Services -->
  <section class="services">
    <div class="container">
      <h2 class="section-title">What I Do</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🎯</div>
          <h3>User Research</h3>
          <p>Interviews, surveys, usability testing, and analytics to understand user needs and behaviors.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🎨</div>
          <h3>UX Design</h3>
          <p>User flows, wireframes, and high-fidelity designs that prioritize accessibility and usability.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>Rapid Prototyping</h3>
          <p>Interactive prototypes in Figma, Axure, and code to validate concepts quickly.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🔧</div>
          <h3>Design Systems</h3>
          <p>Component libraries, design tokens, and documentation for scalable design.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to work together?</h2>
      <p>Let's discuss your project and how I can help bring your vision to life.</p>
      <a href="/contact" class="btn btn--primary">Start a Conversation</a>
    </div>
  </section>

  <style>
    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    /* Section Titles */
    .section-title {
      font-size: 2.5rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 3rem;
      color: #E8EAED;
    }
    
    /* Services */
    .services {
      padding: 6rem 0;
      background: var(--q-surface);
    }
    
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }
    
    .service-card {
      text-align: center;
      padding: 2rem;
    }
    
    .service-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }
    
    .service-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .service-card p {
      color: #A0A0A0;
      line-height: 1.6;
    }
    
    /* CTA */
    .cta-section {
      padding: 6rem 0;
      background: var(--q-bg);
      text-align: center;
    }
    
    .cta-section h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .cta-section p {
      font-size: 1.25rem;
      color: #A0A0A0;
      margin-bottom: 2rem;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .services-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
