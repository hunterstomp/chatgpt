    </div>
    
    <!-- Enhanced Hero Overlay -->
    <div class="hero-overlay"></div>
    
    <!-- Hero Content - Centered -->
    <div class="hero-content">
      <div class="hero-text-content">
        <h1 class="hero-title">
          <span class="hero-title-main">Better Experiences.</span>
          <span class="hero-title-sub">Real Results.</span>
        </h1>
        <p class="hero-subtitle">
          <span class="hero-line-1">Welcome to the UX Portfolio of Quentin Little</span>
          <span class="hero-line-2">Pioneering user experiences for close to 20 years for startup and enterprise</span>
        </p>
        <div class="hero-cta">
          <a href="/case-studies" class="btn btn--primary">View Case Studies</a>
          <a href="/contact" class="btn btn--secondary">Get In Touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Section -->
  <section class="clients-section">
    <div class="container">
      <div class="clients-header">
        <h2 class="section-title">Trusted by Industry Leaders</h2>
        <p class="section-subtitle">Creating impactful digital experiences for Fortune 100 companies and innovative startups</p>
      </div>
    </div>
    
    <!-- Logo Carousel -->
    <div class="logo-carousel-wrapper">
      <div class="carousel-container">
        <div class="carousel-track">
          <!-- Disney -->
          <div class="carousel-item">
            <img src="/assets/logos/DISNEYLOGO.svg" alt="Disney" class="client-logo" loading="lazy">
          </div>
          
          <!-- AT&T -->
          <div class="carousel-item">
            <img src="/assets/logos/ATTLOGO.svg" alt="AT&T" class="client-logo" loading="lazy">
          </div>
          
          <!-- Microsoft -->
          <div class="carousel-item">
            <img src="/assets/logos/MSFTLOGO.svg" alt="Microsoft" class="client-logo" loading="lazy">
          </div>
          
          <!-- AtmosFX -->
          <div class="carousel-item">
            <img src="/assets/logos/POPLOGO.svg" alt="AtmosFX" class="client-logo" loading="lazy">
          </div>
          
          <!-- T-Mobile -->
          <div class="carousel-item">
            <img src="/assets/logos/TMOBILELOGO.svg" alt="T-Mobile" class="client-logo" loading="lazy">
          </div>
          
          <!-- Office 365 -->
          <div class="carousel-item">
            <img src="/assets/logos/OFFICE365LOGO.svg" alt="Office 365" class="client-logo" loading="lazy">
          </div>
          
          <!-- Duplicate logos for seamless loop -->
          <!-- Disney -->
          <div class="carousel-item">
            <img src="/assets/logos/DISNEYLOGO.svg" alt="Disney" class="client-logo" loading="lazy">
          </div>
          
          <!-- AT&T -->
          <div class="carousel-item">
            <img src="/assets/logos/ATTLOGO.svg" alt="AT&T" class="client-logo" loading="lazy">
          </div>
          
          <!-- Microsoft -->
          <div class="carousel-item">
            <img src="/assets/logos/MSFTLOGO.svg" alt="Microsoft" class="client-logo" loading="lazy">
          </div>
          
          <!-- AtmosFX -->
          <div class="carousel-item">
            <img src="/assets/logos/POPLOGO.svg" alt="AtmosFX" class="client-logo" loading="lazy">
          </div>
          
          <!-- T-Mobile -->
