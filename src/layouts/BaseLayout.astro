    <style>
      /* CSS Variables for consistent theming */
      :root {
        /* Dark theme (default) */
        --bg: #0a0a0a;
        --bg-secondary: #1a1a1a;
        --surface: #1a1a1a;
        --text: #ffffff;
        --text-muted: #e0e0e0;
        --accent-1: #00e5ff;
        --accent-2: #0099cc;
        --border: #333333;
        --muted: #333333;
        --q-brand-500: #00e5ff;
        --radius: 12px;
      }

      /* Light theme */
      [data-theme="light"] {
        --bg: #ffffff;
        --bg-secondary: #f8f9fa;
        --surface: #ffffff;
        --text: #1a1a1a;
        --text-muted: #6c757d;
        --accent-1: #007bff;
        --accent-2: #0056b3;
        --border: #dee2e6;
        --muted: #dee2e6;
        --q-brand-500: #007bff;
      }

      /* Skip Link */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: var(--accent-1);
        color: var(--bg);
        padding: 8px;
        text-decoration: none;
        border-radius: 8px;
        z-index: 1000;
        transition: top 0.3s;
      }
      
      .skip-link:focus {
        top: 6px;
      }
      
      /* Header */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(26, 26, 26, 0.7);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        z-index: 1000;
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
      }

      [data-theme="light"] .site-header {
        background: rgba(255, 255, 255, 0.7);
        border-bottom: 1px solid rgba(0, 0, 0, 0.2);
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.1);
      }

      /* Add padding to body to account for fixed header */
      body {
        padding-top: 80px; /* Adjust based on header height */
      }

      /* Scrolled header state */
      .site-header.scrolled {
        background: rgba(26, 26, 26, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.2);
        transform: translateY(0);
      }

      [data-theme="light"] .site-header.scrolled {
        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.15);
      }

      /* Ensure header is always visible and accessible */
      .site-header {
        min-height: 70px;
        display: flex;
        align-items: center;
      }

      /* Smooth scroll behavior for the entire page */
      html {
        scroll-behavior: smooth;
      }
      
      .nav-main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }
      
      .nav-logo img {
        height: 40px;
        width: auto;
      }
      
      .nav-menu {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 2rem;
      }
      
      .nav-link {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        font-size: 1.125rem;
        font-family: 'Roboto Condensed', sans-serif;
        transition: color 0.2s;
      }
      
      .nav-link:hover {
        color: var(--q-brand-500);
      }
      
      /* Mobile Menu Toggle */
      .mobile-menu-toggle {
        display: none; /* Hidden by default */
        flex-direction: column;
        justify-content: space-around;
        width: 30px;
        height: 24px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        box-sizing: border-box;
        z-index: 1001; /* Above other content */
        position: relative;
        overflow: visible;
      }
      
      .mobile-menu-toggle span {
        display: block;
        width: 100%;
        height: 3px;
        background: var(--text);
        border-radius: 2px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: center;
        position: relative;
      }
      
      .mobile-menu-toggle:hover span {
        background: var(--q-brand-500);
      }
      
      /* Hamburger to X animation - Fixed positioning to prevent cutoff */
      .mobile-menu-toggle.active span:nth-child(1) {
        transform: rotate(45deg) translate(6px, 6px);
      }
      
      .mobile-menu-toggle.active span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
      }
      
      .mobile-menu-toggle.active span:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
      }
      
      /* Mobile Menu Overlay - Enhanced blur and darkness */
      .mobile-menu {
        display: none; /* Hidden by default */
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(15px) saturate(180%);
        -webkit-backdrop-filter: blur(15px) saturate(180%);
        z-index: 9999; /* Above everything */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        box-sizing: border-box;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .mobile-menu.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }
      
      .mobile-menu ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
        width: 100%;
        max-width: 350px;
      }
      
      .mobile-menu .nav-link {
        color: #E8EAED;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.5rem;
        font-family: 'Roboto Condensed', sans-serif;
        transition: color 0.2s;
        text-align: center;
        width: 100%;
      }
      
      .mobile-menu .nav-link:hover {
        color: var(--q-brand-500);
      }
      
      .mobile-menu .btn {
        width: 100%;
        text-align: center;
      }
      
      /* Mobile Dropdown Styling */
      .mobile-dropdown {
        width: 100%;
      }
      
      .mobile-dropdown-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
        text-align: left;
      }
      
      .mobile-dropdown-menu .nav-link {
        text-align: left;
        padding-left: 1.5rem;
        position: relative;
        font-size: 0.85rem;
        color: rgba(232, 234, 237, 0.7);
      }
      
      .mobile-dropdown-menu .nav-link::before {
        content: '•';
        position: absolute;
        left: 0;
        color: rgba(0, 229, 255, 0.5);
        font-size: 1.2rem;
      }
      
      .mobile-dropdown-menu .nav-link--primary {
        font-size: 1.1rem;
        font-weight: 800;
        color: #00E5FF;
        padding-left: 0;
        border-bottom: 2px solid rgba(0, 229, 255, 0.4);
        margin-bottom: 0.5rem;
        letter-spacing: 0.8px;
      }
      
      .mobile-dropdown-menu .nav-link--primary::before {
        display: none;
      }
      
      /* Enhanced Theme Toggle Styles */
      .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border-radius: 50%;
        width: 44px;
        height: 44px;
        position: relative;
        overflow: hidden;
      }
      
      .theme-toggle:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.05);
      }
      
      .theme-toggle:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.3);
      }
      
      .toggle-track {
        position: relative;
        width: 44px;
        height: 24px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 2px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      
      .toggle-thumb {
        position: relative;
        width: 20px;
        height: 20px;
        background: #ffffff;
        border-radius: 50%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      }
      
      .toggle-thumb svg {
        color: #333;
        transition: all 0.3s ease;
      }
      
      /* Dark mode styles */
      [data-theme="dark"] .toggle-track {
        background: rgba(0, 0, 0, 0.3);
        border-color: rgba(255, 255, 255, 0.1);
      }
      
      [data-theme="dark"] .toggle-thumb {
        background: #00E5FF;
        transform: translateX(20px);
      }
      
      [data-theme="dark"] .toggle-thumb svg {
        color: #ffffff;
      }
      
      /* Icon visibility */
      .sun-icon {
        display: block;
        opacity: 1;
        transition: all 0.3s ease;
      }
      
      .moon-icon {
        display: none;
        opacity: 0;
        transition: all 0.3s ease;
      }
      
      [data-theme="dark"] .sun-icon {
        display: none;
        opacity: 0;
      }
      
      [data-theme="dark"] .moon-icon {
        display: block;
        opacity: 1;
      }
      
      /* Floating Theme Toggle (Desktop) */
      .floating-theme-toggle {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 1000;
        display: none;
      }
      
      .floating-theme-toggle .theme-toggle {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
      }
      
      .floating-theme-toggle .theme-toggle:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: scale(1.1);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
      }
      
      [data-theme="dark"] .floating-theme-toggle .theme-toggle {
        background: rgba(0, 0, 0, 0.3);
        border-color: rgba(255, 255, 255, 0.1);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      }
      
      [data-theme="dark"] .floating-theme-toggle .theme-toggle:hover {
        background: rgba(0, 0, 0, 0.4);
      }
      
      /* Mobile Theme Toggle */
      .mobile-theme-toggle {
        margin: 1.5rem 0;
        display: flex;
        justify-content: center;
      }
      
      .mobile-theme-toggle .theme-toggle {
        transform: scale(1.2);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }
      
      [data-theme="dark"] .mobile-theme-toggle .theme-toggle {
        background: rgba(0, 0, 0, 0.3);
        border-color: rgba(255, 255, 255, 0.1);
      }
      
      /* Responsive */
      @media (min-width: 1025px) {
        .floating-theme-toggle {
          display: block;
        }
      }
      
      @media (max-width: 768px) {
        body {
          padding-top: 70px; /* Smaller padding for mobile */
        }
        
        .nav-main {
          padding: 1rem;
          flex-wrap: wrap;
        }
        
        .nav-menu {
          order: 3;
          width: 100%;
          justify-content: center;
          margin-top: 1rem;
          display: none; /* Hide desktop menu on mobile */
        }
        
        .mobile-menu-toggle {
          display: flex;
        }
        
        .mobile-menu {
          display: block;
        }
        
        .footer-content {
          grid-template-columns: 1fr;
          text-align: center;
          gap: 2rem;
        }
        
        .footer-bottom {
          padding: 1rem 1rem 0;
        }
      }
      
      /* Tablet Navigation */
      @media (min-width: 769px) and (max-width: 1024px) {
        body {
          padding-top: 75px; /* Medium padding for tablet */
        }
        
        .mobile-menu-toggle {
          display: flex;
        }
        
        .nav-menu {
          display: none; /* Hide desktop menu on tablet */
        }
        
        .mobile-menu {
          display: block;
          background: rgba(0, 0, 0, 0.9);
          backdrop-filter: blur(20px) saturate(200%);
          -webkit-backdrop-filter: blur(20px) saturate(200%);
        }
        
        .mobile-menu .nav-link {
          font-size: 1.4rem;
          padding: 0.8rem 0;
        }
      }
    </style>
  </body>
