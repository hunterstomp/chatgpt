<div id="rp" class="fixed left-0 top-0 h-1 w-0 bg-blue-500/90 z-[60]"></div>
<script>
  const bar=document.getElementById('rp');
  const on=()=>{const h=document.documentElement;const p=(h.scrollTop/(h.scrollHeight-h.clientHeight))*100;bar.style.width=p+'%';};
  addEventListener('scroll',on,{passive:true}); on();
</script>
