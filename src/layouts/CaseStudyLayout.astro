---
import BaseLayout from './BaseLayout.astro';
import CaseStudyGallery from '@/components/CaseStudyGallery.astro';

const { frontmatter, headings } = Astro.props;
const images = frontmatter?.gallery ?? [];

// SEO meta
const title = frontmatter?.title || 'Case Study';
const description = frontmatter?.summary || 'UX case study by Quentin Little';
const hero = frontmatter?.hero || '';
---

<BaseLayout title={title} description={description}>
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Hero Section -->
    {hero && (
      <div class="mb-8">
        <img 
          src={hero} 
          alt={`${title} hero image`}
          class="w-full h-64 md:h-96 object-cover rounded-2xl"
          loading="eager"
        />
      </div>
    )}

    <!-- Title and Meta -->
    <header class="mb-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{title}</h1>
      {frontmatter?.client && (
        <p class="text-xl text-gray-600 mb-2">Client: {frontmatter.client}</p>
      )}
      {frontmatter?.role && (
        <p class="text-lg text-gray-600 mb-4">Role: {Array.isArray(frontmatter.role) ? frontmatter.role.join(', ') : frontmatter.role}</p>
      )}
      {frontmatter?.summary && (
        <p class="text-xl leading-relaxed text-gray-700 mb-6">{frontmatter.summary}</p>
      )}
    </header>

    <!-- Gallery (auto-renders if frontmatter.gallery exists) -->
    {images.length > 0 && (
      <CaseStudyGallery images={images} />
    )}

    <!-- Content -->
    <article class="prose prose-lg max-w-none">
      <slot />
    </article>

    <!-- Navigation -->
    <nav class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex justify-between">
        <a href="/case-studies" class="btn btn--secondary">← All Case Studies</a>
        <a href="/contact" class="btn btn--primary">Get in Touch</a>
      </div>
    </nav>
  </main>
</BaseLayout>
