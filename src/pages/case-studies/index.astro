---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroCarousel from '../../components/HeroCarousel.astro';
import HeroHeading from '../../components/HeroHeading.astro';
import PageTransitions from '../../components/PageTransitions.astro';
import { absUrl } from "@/lib/absUrl";

const items = (await Astro.glob('./*.md*')).map(p => {
  const fm = p.frontmatter ?? {};
  const first = Array.isArray(fm.gallery) && fm.gallery[0]?.src;
  return {
    ...fm,
    href: `/case-studies/${fm.slug || p.file.replace(/\.mdx?$/,'')}/`,
    thumb: absUrl(fm.thumb || first),
  };
});

// Hero images for the case studies hub
const heroImages = [
  "/assets/cases-hub/2015-gates-annual-letter-2-2000x1068-800x427.png",
  "/assets/cases-hub/2015-gates-annual-letter-2-2000x1068.png",
  "/assets/cases-hub/hero-bmgf-1276x1754.jpg"
];
---

<BaseLayout 
  title="Case Studies - Quentin Little"
  description="UX case studies from Disney, AT&T, AtmosFX, Microsoft, and Bill & Melinda Gates Foundation. Enterprise UX, accessibility, and design systems."
>
  <PageTransitions />
  
  <!-- Hero Section with Carousel -->
  <HeroCarousel images={heroImages} height="50vh" interval={6500}>
    <HeroHeading 
      title="Case Studies"
      subtitle="UX projects spanning enterprise software, eCommerce, gaming, and non-profit work"
      showCTAs={false}
    />
  </HeroCarousel>

  <!-- Case Studies Grid -->
  <section class="case-studies">
    <div class="container">
      <div class="case-studies-grid">
        {items.map(study => (
          <article class="case-study-card">
            <div class="card-image">
              <img 
                src={study.thumb || '/assets/placeholder-case-study.webp'} 
                alt={`${study.title} case study`}
                width="400"
                height="250"
                loading="lazy"
                decoding="async"
              />
              <div class="card-overlay">
                <a href={study.href} class="btn btn--primary">
                  View Case Study
                </a>
              </div>
            </div>
            <div class="card-content">
              <div class="card-meta">
                <span class="client">{study.client}</span>
                <span class="date">{study.date}</span>
              </div>
              <h2 class="card-title">
                <a href={study.href}>{study.title}</a>
              </h2>
              <p class="card-summary">{study.summary}</p>
              <div class="tags">
                {study.tags?.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Interested in working together?</h2>
      <p>Let's discuss your project and how I can help create exceptional user experiences.</p>
      <a href="/contact" class="btn btn--primary">Get in Touch</a>
    </div>
  </section>

  <style>
    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    /* Case Studies */
    .case-studies {
      padding: 4rem 0;
      background: var(--q-bg);
    }
    
    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 2rem;
    }
    
    .case-study-card {
      background: var(--q-surface);
      border: 1px solid var(--q-border);
      border-radius: var(--q-radius-lg);
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .case-study-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .card-image {
      position: relative;
      overflow: hidden;
    }
    
    .card-image img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      transition: transform 0.3s;
    }
    
    .case-study-card:hover .card-image img {
      transform: scale(1.05);
    }
    
    .card-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s;
    }
    
    .case-study-card:hover .card-overlay {
      opacity: 1;
    }
    
    .card-content {
      padding: 1.5rem;
    }
    
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    
    .client {
      font-size: 0.875rem;
      color: var(--q-brand-500);
      font-weight: 600;
    }
    
    .date {
      font-size: 0.875rem;
      color: #A0A0A0;
    }
    
    .card-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    
    .card-title a {
      color: #E8EAED;
      text-decoration: none;
      transition: color 0.2s;
    }
    
    .card-title a:hover {
      color: var(--q-brand-500);
    }
    
    .card-summary {
      color: #A0A0A0;
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    
    .tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .tag {
      background: rgba(255,255,255,0.1);
      color: #A0A0A0;
      padding: 0.25rem 0.75rem;
      border-radius: var(--q-radius-pill);
      font-size: 0.75rem;
      font-weight: 500;
    }
    
    /* CTA */
    .cta-section {
      padding: 4rem 0;
      background: var(--q-surface);
      text-align: center;
    }
    
    .cta-section h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .cta-section p {
      font-size: 1.125rem;
      color: #A0A0A0;
      margin-bottom: 2rem;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .case-studies-grid {
        grid-template-columns: 1fr;
      }
      
      .card-overlay {
        opacity: 1;
        background: rgba(0,0,0,0.5);
      }
    }
  </style>
</BaseLayout>
