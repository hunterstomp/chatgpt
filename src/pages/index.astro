---
import BaseLayout from '../layouts/BaseLayout.astro';

// Import case study data (we'll create this)
const featuredCaseStudies = [
  {
    title: "AtmosFX eCommerce Platform",
    client: "AtmosFX",
    slug: "atmosfx-ecommerce",
    hero: "/assets/case-studies/atmosfx-ecommerce/hero.webp",
    summary: "Redesigned eCommerce platform increased conversion by 38%",
    tags: ["eCommerce", "UX Design", "Prototyping"]
  },
  {
    title: "AT&T International Roaming",
    client: "AT&T",
    slug: "att-international-roaming", 
    hero: "/assets/case-studies/att-roaming/hero.webp",
    summary: "Streamlined international roaming experience for millions of users",
    tags: ["Enterprise", "Mobile", "User Research"]
  },
  {
    title: "Disney Bug Tracking System",
    client: "Disney",
    slug: "disney-bug-tracking",
    hero: "/assets/case-studies/disney-bugs/hero.webp", 
    summary: "Built comprehensive bug tracking system for Club Penguin",
    tags: ["Gaming", "Dashboard", "Development"]
  }
];
---

<BaseLayout 
  title="Quentin Little - UX Designer & Prototyper"
  description="Enterprise UX designer specializing in accessibility, design systems, and user research. Case studies from Disney, AT&T, AtmosFX, and Microsoft."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-name">Quentin Little</span>
        <span class="hero-role">UX Designer & Prototyper</span>
      </h1>
      <p class="hero-description">
        I design accessible, scalable experiences for enterprise users. 
        Specializing in design systems, user research, and rapid prototyping.
      </p>
      <div class="hero-actions">
        <a href="/case-studies" class="btn btn--primary">View Case Studies</a>
        <a href="/contact" class="btn btn--secondary">Get in Touch</a>
      </div>
    </div>
    <div class="hero-visual">
      <img 
        src="/assets/hero-portrait.webp" 
        alt="Quentin Little - UX Designer" 
        width="400" 
        height="500"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <!-- Featured Work -->
  <section class="featured-work">
    <div class="container">
      <h2 class="section-title">Featured Work</h2>
      <div class="case-studies-grid">
        {featuredCaseStudies.map(study => (
          <article class="case-study-card">
            <div class="card-image">
              <img 
                src={study.hero} 
                alt={`${study.title} case study`}
                width="400"
                height="250"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-content">
              <div class="card-meta">
                <span class="client">{study.client}</span>
                <div class="tags">
                  {study.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <h3 class="card-title">{study.title}</h3>
              <p class="card-summary">{study.summary}</p>
              <a href={`/case-studies/${study.slug}`} class="btn btn--tertiary">
                View Case Study
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="view-all">
        <a href="/case-studies" class="btn btn--secondary">View All Case Studies</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services">
    <div class="container">
      <h2 class="section-title">What I Do</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🎯</div>
          <h3>User Research</h3>
          <p>Interviews, surveys, usability testing, and analytics to understand user needs and behaviors.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🎨</div>
          <h3>UX Design</h3>
          <p>User flows, wireframes, and high-fidelity designs that prioritize accessibility and usability.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>Rapid Prototyping</h3>
          <p>Interactive prototypes in Figma, Axure, and code to validate concepts quickly.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🔧</div>
          <h3>Design Systems</h3>
          <p>Component libraries, design tokens, and documentation for scalable design.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to work together?</h2>
      <p>Let's discuss your project and how I can help bring your vision to life.</p>
      <a href="/contact" class="btn btn--primary">Start a Conversation</a>
    </div>
  </section>

  <style>
    /* Hero */
    .hero {
      min-height: 80vh;
      display: flex;
      align-items: center;
      padding: 4rem 2rem;
      background: linear-gradient(135deg, var(--q-surface) 0%, var(--q-bg) 100%);
    }
    
    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    
    .hero-title {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    
    .hero-name {
      font-family: var(--q-font-display);
      font-size: var(--q-h1);
      color: var(--q-brand-500);
      line-height: 0.9;
    }
    
    .hero-role {
      font-size: 1.5rem;
      color: #E8EAED;
      font-weight: 400;
    }
    
    .hero-description {
      font-size: 1.25rem;
      line-height: 1.6;
      color: #A0A0A0;
      margin-bottom: 2rem;
    }
    
    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    
    .hero-visual img {
      width: 100%;
      height: auto;
      border-radius: var(--q-radius-lg);
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }
    
    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    /* Section Titles */
    .section-title {
      font-size: 2.5rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 3rem;
      color: #E8EAED;
    }
    
    /* Featured Work */
    .featured-work {
      padding: 6rem 0;
      background: var(--q-bg);
    }
    
    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }
    
    .case-study-card {
      background: var(--q-surface);
      border: 1px solid var(--q-border);
      border-radius: var(--q-radius-lg);
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .case-study-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .card-image img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    
    .card-content {
      padding: 1.5rem;
    }
    
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    
    .client {
      font-size: 0.875rem;
      color: var(--q-brand-500);
      font-weight: 600;
    }
    
    .tags {
      display: flex;
      gap: 0.5rem;
    }
    
    .tag {
      background: rgba(255,255,255,0.1);
      color: #A0A0A0;
      padding: 0.25rem 0.5rem;
      border-radius: var(--q-radius-pill);
      font-size: 0.75rem;
    }
    
    .card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: #E8EAED;
    }
    
    .card-summary {
      color: #A0A0A0;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }
    
    .view-all {
      text-align: center;
    }
    
    /* Services */
    .services {
      padding: 6rem 0;
      background: var(--q-surface);
    }
    
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }
    
    .service-card {
      text-align: center;
      padding: 2rem;
    }
    
    .service-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }
    
    .service-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .service-card p {
      color: #A0A0A0;
      line-height: 1.6;
    }
    
    /* CTA */
    .cta-section {
      padding: 6rem 0;
      background: var(--q-bg);
      text-align: center;
    }
    
    .cta-section h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .cta-section p {
      font-size: 1.25rem;
      color: #A0A0A0;
      margin-bottom: 2rem;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
      }
      
      .hero-name {
        font-size: 3rem;
      }
      
      .hero-actions {
        justify-content: center;
      }
      
      .case-studies-grid {
        grid-template-columns: 1fr;
      }
      
      .services-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
