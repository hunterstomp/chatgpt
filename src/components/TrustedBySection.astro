---
// Trusted By Section Component
// Includes header and logo carousel
---

<section class="trusted-by-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Trusted by Industry Leaders</h2>
      <p class="section-subtitle">Creating impactful digital experiences for Fortune 100 companies</p>
    </div>
  </div>
  
  <!-- Logo Carousel -->
  <div class="logo-carousel-wrapper">
    <div class="carousel-container">
      <div class="carousel-track">
        <!-- Disney -->
        <div class="carousel-item">
          <img src="/assets/logos/DISNEYLOGO.svg" alt="Disney" class="client-logo" loading="lazy">
        </div>
        
        <!-- AT&T -->
        <div class="carousel-item">
          <img src="/assets/logos/ATTLOGO.svg" alt="AT&T" class="client-logo" loading="lazy">
        </div>
        
        <!-- Microsoft -->
        <div class="carousel-item">
          <img src="/assets/logos/MSFTLOGO.svg" alt="Microsoft" class="client-logo" loading="lazy">
        </div>
        
        <!-- Microsoft Office -->
        <div class="carousel-item">
          <img src="/assets/logos/MSFTOFFICE.svg" alt="Microsoft Office" class="client-logo" loading="lazy">
        </div>
        
        <!-- Office 365 -->
        <div class="carousel-item">
          <img src="/assets/logos/OFFICE365LOGO.svg" alt="Office 365" class="client-logo" loading="lazy">
        </div>
        
        <!-- POP (Bill & Melinda Gates Foundation) -->
        <div class="carousel-item">
          <img src="/assets/logos/POPLOGO.svg" alt="Bill & Melinda Gates Foundation" class="client-logo" loading="lazy">
        </div>
        
        <!-- T-Mobile -->
        <div class="carousel-item">
          <img src="/assets/logos/TMOBILELOGO.svg" alt="T-Mobile" class="client-logo" loading="lazy">
        </div>
        
        <!-- Travelport -->
        <div class="carousel-item">
          <img src="/assets/logos/TRAVELPORTLOGO.svg" alt="Travelport" class="client-logo" loading="lazy">
        </div>
        
        <!-- Volt -->
        <div class="carousel-item">
          <img src="/assets/logos/VOLTLOGO.svg" alt="Volt" class="client-logo" loading="lazy">
        </div>
        
        <!-- Duplicate logos for seamless loop -->
        <!-- Disney -->
        <div class="carousel-item">
          <img src="/assets/logos/DISNEYLOGO.svg" alt="Disney" class="client-logo" loading="lazy">
        </div>
        
        <!-- AT&T -->
        <div class="carousel-item">
          <img src="/assets/logos/ATTLOGO.svg" alt="AT&T" class="client-logo" loading="lazy">
        </div>
        
        <!-- Microsoft -->
        <div class="carousel-item">
          <img src="/assets/logos/MSFTLOGO.svg" alt="Microsoft" class="client-logo" loading="lazy">
        </div>
        
        <!-- Microsoft Office -->
        <div class="carousel-item">
          <img src="/assets/logos/MSFTOFFICE.svg" alt="Microsoft Office" class="client-logo" loading="lazy">
        </div>
        
        <!-- Office 365 -->
        <div class="carousel-item">
          <img src="/assets/logos/OFFICE365LOGO.svg" alt="Office 365" class="client-logo" loading="lazy">
        </div>
        
        <!-- POP (Bill & Melinda Gates Foundation) -->
        <div class="carousel-item">
          <img src="/assets/logos/POPLOGO.svg" alt="Bill & Melinda Gates Foundation" class="client-logo" loading="lazy">
        </div>
        
        <!-- T-Mobile -->
        <div class="carousel-item">
          <img src="/assets/logos/TMOBILELOGO.svg" alt="T-Mobile" class="client-logo" loading="lazy">
        </div>
        
        <!-- Travelport -->
        <div class="carousel-item">
          <img src="/assets/logos/TRAVELPORTLOGO.svg" alt="Travelport" class="client-logo" loading="lazy">
        </div>
        
        <!-- Volt -->
        <div class="carousel-item">
          <img src="/assets/logos/VOLTLOGO.svg" alt="Volt" class="client-logo" loading="lazy">
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.trusted-by-section {
  background: var(--surface);
  padding: 6rem 0 4rem;
  border-top: 1px solid var(--muted);
  border-bottom: 1px solid var(--muted);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.section-header {
  text-align: center;
  margin-bottom: 4rem;
}

.section-title {
  font-family: 'Roboto Condensed', sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  color: var(--text);
  margin: 0 0 1rem 0;
  line-height: 1.2;
}

.section-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 1.125rem;
  font-weight: 400;
  color: var(--text);
  margin: 0;
  opacity: 0.9;
  line-height: 1.6;
}

.logo-carousel-wrapper {
  overflow: hidden;
  width: 100vw;
  margin-left: calc(-50vw + 50%);
  margin-right: calc(-50vw + 50%);
}

.carousel-container {
  max-width: 100%;
  overflow: hidden;
  position: relative;
}

.carousel-track {
  display: flex;
  animation: scroll 40s linear infinite;
  width: calc(200px * 18);
}

.carousel-item {
  flex: 0 0 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 2rem;
  height: 80px;
}

.client-logo {
  max-width: 140px;
  max-height: 60px;
  width: auto;
  height: auto;
  filter: grayscale(100%) brightness(0.7);
  transition: all 0.3s ease;
  opacity: 0.8;
}

.client-logo:hover {
  filter: grayscale(0%) brightness(1);
  opacity: 1;
  transform: scale(1.05);
}

@keyframes scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(calc(-200px * 9));
  }
}

/* Pause animation on hover */
.carousel-container:hover .carousel-track {
  animation-play-state: paused;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .trusted-by-section {
    padding: 4rem 0 3rem;
  }
  
  .section-title {
    font-size: 2rem;
  }
  
  .section-subtitle {
    font-size: 1rem;
  }
  
  .section-header {
    margin-bottom: 3rem;
  }
  
  .carousel-item {
    flex: 0 0 150px;
    padding: 0 1rem;
    height: 60px;
  }
  
  .client-logo {
    max-width: 100px;
    max-height: 40px;
  }
  
  .carousel-track {
    width: calc(150px * 18);
  }
  
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-150px * 9));
    }
  }
}

@media (max-width: 480px) {
  .section-title {
    font-size: 1.75rem;
  }
  
  .carousel-item {
    flex: 0 0 120px;
    padding: 0 0.5rem;
  }
  
  .client-logo {
    max-width: 80px;
    max-height: 30px;
  }
  
  .carousel-track {
    width: calc(120px * 18);
  }
  
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-120px * 9));
    }
  }
}

/* Accessibility improvements */
@media (prefers-reduced-motion: reduce) {
  .carousel-track {
    animation: none;
  }
  
  .carousel-container:hover .carousel-track {
    animation-play-state: running;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .client-logo {
    filter: grayscale(0%) brightness(1);
    opacity: 1;
  }
}
</style>
