---
import BaseLayout from '../../layouts/BaseLayout.astro';

// This would come from a data file or CMS
const allCaseStudies = [
  {
    title: "AtmosFX eCommerce Platform",
    client: "AtmosFX",
    slug: "atmosfx-ecommerce",
    hero: "/assets/case-studies/atmosfx-ecommerce/hero.webp",
    summary: "Redesigned eCommerce platform increased conversion by 38%",
    tags: ["eCommerce", "UX Design", "Prototyping"],
    date: "2024"
  },
  {
    title: "AT&T International Roaming",
    client: "AT&T",
    slug: "att-international-roaming",
    hero: "/assets/case-studies/att-roaming/hero.webp", 
    summary: "Streamlined international roaming experience for millions of users",
    tags: ["Enterprise", "Mobile", "User Research"],
    date: "2023"
  },
  {
    title: "Disney Bug Tracking System",
    client: "Disney",
    slug: "disney-bug-tracking",
    hero: "/assets/case-studies/disney-bugs/hero.webp",
    summary: "Built comprehensive bug tracking system for Club Penguin",
    tags: ["Gaming", "Dashboard", "Development"],
    date: "2022"
  },
  {
    title: "Microsoft Office 365",
    client: "Microsoft",
    slug: "microsoft-office-365",
    hero: "/assets/case-studies/microsoft-o365/hero.webp",
    summary: "Redesigned Office 365 admin experience for enterprise customers",
    tags: ["Enterprise", "Admin Tools", "Design System"],
    date: "2021"
  },
  {
    title: "Bill & Melinda Gates Foundation",
    client: "BMGF",
    slug: "bmgf-annual-letter",
    hero: "/assets/case-studies/bmgf-letter/hero.webp",
    summary: "Interactive annual letter experience with data visualization",
    tags: ["Non-profit", "Data Viz", "Storytelling"],
    date: "2020"
  }
];
---

<BaseLayout 
  title="Case Studies - Quentin Little"
  description="UX case studies from Disney, AT&T, AtmosFX, Microsoft, and Bill & Melinda Gates Foundation. Enterprise UX, accessibility, and design systems."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Case Studies</h1>
      <p class="page-description">
        A collection of UX projects spanning enterprise software, eCommerce, gaming, and non-profit work. 
        Each case study demonstrates my approach to user research, design, and validation.
      </p>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="case-studies">
    <div class="container">
      <div class="case-studies-grid">
        {allCaseStudies.map(study => (
          <article class="case-study-card">
            <div class="card-image">
              <img 
                src={study.hero} 
                alt={`${study.title} case study`}
                width="400"
                height="250"
                loading="lazy"
                decoding="async"
              />
              <div class="card-overlay">
                <a href={`/case-studies/${study.slug}`} class="btn btn--primary">
                  View Case Study
                </a>
              </div>
            </div>
            <div class="card-content">
              <div class="card-meta">
                <span class="client">{study.client}</span>
                <span class="date">{study.date}</span>
              </div>
              <h2 class="card-title">
                <a href={`/case-studies/${study.slug}`}>{study.title}</a>
              </h2>
              <p class="card-summary">{study.summary}</p>
              <div class="tags">
                {study.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Interested in working together?</h2>
      <p>Let's discuss your project and how I can help create exceptional user experiences.</p>
      <a href="/contact" class="btn btn--primary">Get in Touch</a>
    </div>
  </section>

  <style>
    /* Page Header */
    .page-header {
      padding: 4rem 0;
      background: var(--q-surface);
      border-bottom: 1px solid var(--q-border);
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    .page-title {
      font-size: 3rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .page-description {
      font-size: 1.25rem;
      line-height: 1.6;
      color: #A0A0A0;
      max-width: 600px;
    }
    
    /* Case Studies */
    .case-studies {
      padding: 4rem 0;
      background: var(--q-bg);
    }
    
    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 2rem;
    }
    
    .case-study-card {
      background: var(--q-surface);
      border: 1px solid var(--q-border);
      border-radius: var(--q-radius-lg);
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .case-study-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .card-image {
      position: relative;
      overflow: hidden;
    }
    
    .card-image img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      transition: transform 0.3s;
    }
    
    .case-study-card:hover .card-image img {
      transform: scale(1.05);
    }
    
    .card-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s;
    }
    
    .case-study-card:hover .card-overlay {
      opacity: 1;
    }
    
    .card-content {
      padding: 1.5rem;
    }
    
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    
    .client {
      font-size: 0.875rem;
      color: var(--q-brand-500);
      font-weight: 600;
    }
    
    .date {
      font-size: 0.875rem;
      color: #A0A0A0;
    }
    
    .card-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    
    .card-title a {
      color: #E8EAED;
      text-decoration: none;
      transition: color 0.2s;
    }
    
    .card-title a:hover {
      color: var(--q-brand-500);
    }
    
    .card-summary {
      color: #A0A0A0;
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    
    .tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .tag {
      background: rgba(255,255,255,0.1);
      color: #A0A0A0;
      padding: 0.25rem 0.75rem;
      border-radius: var(--q-radius-pill);
      font-size: 0.75rem;
      font-weight: 500;
    }
    
    /* CTA */
    .cta-section {
      padding: 4rem 0;
      background: var(--q-surface);
      text-align: center;
    }
    
    .cta-section h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .cta-section p {
      font-size: 1.125rem;
      color: #A0A0A0;
      margin-bottom: 2rem;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .page-title {
        font-size: 2rem;
      }
      
      .case-studies-grid {
        grid-template-columns: 1fr;
      }
      
      .card-overlay {
        opacity: 1;
        background: rgba(0,0,0,0.5);
      }
    }
  </style>
</BaseLayout>
