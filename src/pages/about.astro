  }

  .footer-section {
    background: #2c3e50;
    color: white;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 30px;
    text-align: center;
  }

  /* About Me Content */
  .about-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .about-text,
  .career-section,
  .what-sets-apart,
  .sabbatical-section,
