---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedCard from '../components/AnimatedCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Reveal from '../components/Reveal.astro';
---

<BaseLayout title="Animation & Transition Demo - Q10UX Portfolio">
  <main class="animation-demo">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <ScrollReveal animation="slide-up" delay={0.2}>
          <h1 class="hero-title">Animation & Transition System</h1>
        </ScrollReveal>
        
        <ScrollReveal animation="slide-up" delay={0.4}>
          <p class="hero-subtitle">
            Comprehensive animation and transition capabilities for the Q10UX portfolio
          </p>
        </ScrollReveal>
        
        <ScrollReveal animation="slide-up" delay={0.6}>
          <div class="hero-buttons">
            <button class="btn btn-hover ripple bounce-click">Primary Action</button>
            <button class="btn btn-secondary btn-hover ripple bounce-click">Secondary Action</button>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Animation Showcase -->
    <section class="showcase-section">
      <div class="container">
        <ScrollReveal animation="fade-in">
          <h2>Animation Variants</h2>
        </ScrollReveal>
        
        <div class="animation-grid stagger-children">
          <Reveal as="div" class="animation-card" delay={0.1}>
            <h3>Fade In</h3>
            <div class="demo-element fade-in">Element</div>
          </Reveal>
          
          <Reveal as="div" class="animation-card" delay={0.2}>
            <h3>Slide Up</h3>
            <div class="demo-element slide-up">Element</div>
          </Reveal>
          
          <Reveal as="div" class="animation-card" delay={0.3}>
            <h3>Scale In</h3>
            <div class="demo-element scale-in">Element</div>
          </Reveal>
          
          <Reveal as="div" class="animation-card" delay={0.4}>
            <h3>Rotate In</h3>
            <div class="demo-element rotate-in">Element</div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Interactive Cards -->
    <section class="cards-section">
      <div class="container">
        <ScrollReveal animation="slide-up">
          <h2>Interactive Cards</h2>
        </ScrollReveal>
        
        <div class="cards-grid">
          <AnimatedCard
            title="Card with Hover"
            description="This card demonstrates hover animations and transitions"
            animation="slide-up"
            delay={0.1}
            hover={true}
          />
          
          <AnimatedCard
            title="Scale Animation"
            description="This card uses scale-in animation on load"
            animation="scale-in"
            delay={0.2}
            hover={true}
          />
          
          <AnimatedCard
            title="Rotate Animation"
            description="This card uses rotate-in animation with bounce easing"
            animation="rotate-in"
            delay={0.3}
            hover={true}
          />
        </div>
      </div>
    </section>

    <!-- Transition Examples -->
    <section class="transitions-section">
      <div class="container">
        <ScrollReveal animation="slide-up">
          <h2>Transition Examples</h2>
        </ScrollReveal>
        
        <div class="transition-demos">
          <div class="transition-demo">
            <h3>Button Transitions</h3>
            <div class="button-group">
              <button class="btn btn-hover ripple bounce-click">Hover Me</button>
              <button class="btn btn-secondary btn-hover ripple bounce-click">Secondary</button>
              <button class="btn btn-ghost btn-hover ripple bounce-click">Ghost</button>
            </div>
          </div>
          
          <div class="transition-demo">
            <h3>Form Elements</h3>
            <div class="form-group">
              <input type="text" placeholder="Focus me for transition" class="form-input" />
              <textarea placeholder="Textarea with transitions" class="form-textarea"></textarea>
            </div>
          </div>
          
          <div class="transition-demo">
            <h3>Image Hover</h3>
            <div class="image-demo">
              <img 
                src="https://via.placeholder.com/300x200/00E5FF/FFFFFF?text=Hover+Me" 
                alt="Demo image" 
                class="img-hover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Loading States -->
    <section class="loading-section">
      <div class="container">
        <ScrollReveal animation="slide-up">
          <h2>Loading States</h2>
        </ScrollReveal>
        
        <div class="loading-demos">
          <div class="loading-demo">
            <h3>Spinner</h3>
            <div class="spinner"></div>
          </div>
          
          <div class="loading-demo">
            <h3>Pulse</h3>
            <div class="pulse-demo">
              <div class="pulse">Loading...</div>
            </div>
          </div>
          
          <div class="loading-demo">
            <h3>Skeleton</h3>
            <div class="skeleton-demo">
              <div class="skeleton skeleton-text"></div>
              <div class="skeleton skeleton-text"></div>
              <div class="skeleton skeleton-text"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Scroll Reveal Examples -->
    <section class="scroll-reveal-section">
      <div class="container">
        <ScrollReveal animation="slide-up">
          <h2>Scroll Reveal Examples</h2>
        </ScrollReveal>
        
        <div class="reveal-grid">
          <ScrollReveal animation="fade-in" delay={0.1}>
            <div class="reveal-card">
              <h3>Fade In</h3>
              <p>This element fades in when scrolled into view</p>
            </div>
          </ScrollReveal>
          
          <ScrollReveal animation="slide-up" delay={0.2}>
            <div class="reveal-card">
              <h3>Slide Up</h3>
              <p>This element slides up when scrolled into view</p>
            </div>
          </ScrollReveal>
          
          <ScrollReveal animation="scale-in" delay={0.3}>
            <div class="reveal-card">
              <h3>Scale In</h3>
              <p>This element scales in when scrolled into view</p>
            </div>
          </ScrollReveal>
          
          <ScrollReveal animation="rotate-in" delay={0.4}>
            <div class="reveal-card">
              <h3>Rotate In</h3>
              <p>This element rotates in when scrolled into view</p>
            </div>
          </ScrollReveal>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .animation-demo {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
  }

  .hero-section {
    padding: 8rem 0 4rem;
    text-align: center;
    background: linear-gradient(135deg, var(--surface) 0%, var(--bg) 100%);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
    opacity: 0.8;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .showcase-section,
  .cards-section,
  .transitions-section,
  .loading-section,
  .scroll-reveal-section {
    padding: 4rem 0;
  }

  .animation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .animation-card {
    background: var(--surface);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid var(--muted);
  }

  .demo-element {
    width: 100px;
    height: 100px;
    background: var(--accent-1);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem auto;
    font-weight: bold;
    color: var(--bg);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .transition-demos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .transition-demo {
    background: var(--surface);
    padding: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--muted);
  }

  .button-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-input,
  .form-textarea {
    padding: 0.75rem;
    border: 1px solid var(--muted);
    border-radius: calc(var(--radius) - 4px);
    background: var(--bg);
    color: var(--text);
    font-size: 1rem;
  }

  .form-textarea {
    min-height: 100px;
    resize: vertical;
  }

  .image-demo {
    text-align: center;
  }

  .image-demo img {
    border-radius: var(--radius);
    max-width: 100%;
  }

  .loading-demos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .loading-demo {
    background: var(--surface);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid var(--muted);
  }

  .pulse-demo {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60px;
  }

  .skeleton-demo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skeleton-text {
    height: 1rem;
    border-radius: 4px;
  }

  .reveal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .reveal-card {
    background: var(--surface);
    padding: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--muted);
    min-height: 200px;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--accent-1);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .hero-section {
      padding: 6rem 0 3rem;
    }
    
    .hero-buttons {
      flex-direction: column;
      align-items: center;
    }
    
    .animation-grid,
    .cards-grid,
    .transition-demos,
    .loading-demos,
    .reveal-grid {
      grid-template-columns: 1fr;
    }
    
    .button-group {
      flex-direction: column;
    }
  }
</style>
