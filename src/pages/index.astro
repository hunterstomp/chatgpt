---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTransitions from '../components/PageTransitions.astro';
---

<BaseLayout 
  title="Quentin Little - UX Designer & Prototyper"
  description="Enterprise UX designer specializing in accessibility, design systems, and user research. Case studies from AT&T, AtmosFX, Microsoft, and T-Mobile."
>
