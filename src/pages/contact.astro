---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact - Quentin Little"
  description="Get in touch to discuss your UX project. I specialize in enterprise software, accessibility, and design systems."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Let's Work Together</h1>
          <p class="lead">
            I'm always interested in new opportunities to create exceptional user experiences. 
            Whether you have a specific project in mind or just want to chat about UX, I'd love to hear from you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form & Info -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="contact-form">
          <h2>Send a Message</h2>
          <form action="/api/contact" method="POST" class="form">
            <div class="form-group">
              <label for="name">Name *</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="form-input"
                placeholder="Your name"
              />
            </div>
            
            <div class="form-group">
              <label for="email">Email *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="form-input"
                placeholder="your.email@example.com"
              />
            </div>
            
            <div class="form-group">
              <label for="company">Company</label>
              <input 
                type="text" 
                id="company" 
                name="company" 
                class="form-input"
                placeholder="Your company (optional)"
              />
            </div>
            
            <div class="form-group">
              <label for="project-type">Project Type</label>
              <select id="project-type" name="projectType" class="form-select">
                <option value="">Select a project type</option>
                <option value="ux-design">UX Design</option>
                <option value="user-research">User Research</option>
                <option value="prototyping">Prototyping</option>
                <option value="design-system">Design System</option>
                <option value="accessibility">Accessibility Audit</option>
                <option value="consultation">Consultation</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="message">Message *</label>
              <textarea 
                id="message" 
                name="message" 
                required 
                rows="6"
                class="form-textarea"
                placeholder="Tell me about your project, timeline, and any specific requirements..."
              ></textarea>
            </div>
            
            <button type="submit" class="btn btn--primary">Send Message</button>
          </form>
        </div>
        
        <!-- Contact Info -->
        <div class="contact-info">
          <h2>Get in Touch</h2>
          <p>
            I'm based in Seattle and available for remote work worldwide. 
            I typically respond within 24 hours during business days.
          </p>
          
          <div class="contact-methods">
            <div class="contact-method">
              <div class="method-icon">📧</div>
              <div class="method-content">
                <h3>Email</h3>
                <a href="mailto:hello@q10ux.com" class="method-link">hello@q10ux.com</a>
              </div>
            </div>
            
            <div class="contact-method">
              <div class="method-icon">💼</div>
              <div class="method-content">
                <h3>LinkedIn</h3>
                <a href="https://linkedin.com/in/quentinlittle" class="method-link" target="_blank" rel="noopener">
                  linkedin.com/in/quentinlittle
                </a>
              </div>
            </div>
            
            <div class="contact-method">
              <div class="method-icon">🐙</div>
              <div class="method-content">
                <h3>GitHub</h3>
                <a href="https://github.com/quentstyle" class="method-link" target="_blank" rel="noopener">
                  github.com/quentstyle
                </a>
              </div>
            </div>
          </div>
          
          <div class="availability">
            <h3>Availability</h3>
            <p>
              I'm currently available for new projects and consulting work. 
              I prefer long-term engagements but also take on select short-term projects.
            </p>
            <div class="availability-status">
              <span class="status-indicator available"></span>
              <span>Available for new projects</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h3>What types of projects do you work on?</h3>
          <p>
            I specialize in enterprise software, eCommerce, and complex web applications. 
            My experience includes user research, UX design, prototyping, and design systems.
          </p>
        </div>
        
        <div class="faq-item">
          <h3>Do you work remotely?</h3>
          <p>
            Yes, I work remotely with clients worldwide. I'm based in Seattle (PST) 
            but am flexible with meeting times across different time zones.
          </p>
        </div>
        
        <div class="faq-item">
          <h3>What's your typical project timeline?</h3>
          <p>
            Project timelines vary based on scope and complexity. A typical UX project 
            might take 4-8 weeks, while design system work can span 2-3 months.
          </p>
        </div>
        
        <div class="faq-item">
          <h3>Do you handle accessibility?</h3>
          <p>
            Absolutely. Accessibility is built into my process from day one. 
            I ensure all designs meet WCAG 2.1 AA standards and conduct accessibility audits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    /* Hero */
    .hero {
      padding: 4rem 0;
      background: var(--q-surface);
      text-align: center;
    }
    
    .hero h1 {
      font-size: 3rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: #E8EAED;
    }
    
    .lead {
      font-size: 1.25rem;
      line-height: 1.6;
      color: #A0A0A0;
      max-width: 600px;
      margin: 0 auto;
    }
    
    /* Contact Section */
    .contact-section {
      padding: 4rem 0;
      background: var(--q-bg);
    }
    
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    
    .contact-form h2, .contact-info h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 2rem;
      color: #E8EAED;
    }
    
    /* Form Styles */
    .form-group {
      margin-bottom: 1.5rem;
    }
    
    label {
      display: block;
      margin-bottom: 0.5rem;
      color: #E8EAED;
      font-weight: 500;
    }
    
    .form-input, .form-select, .form-textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--q-border);
      border-radius: var(--q-radius-md);
      background: var(--q-surface);
      color: #E8EAED;
      font-size: 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none;
      border-color: var(--q-brand-500);
      box-shadow: var(--q-shadow-focus);
    }
    
    .form-textarea {
      resize: vertical;
      min-height: 120px;
    }
    
    /* Contact Info */
    .contact-info p {
      color: #A0A0A0;
      line-height: 1.6;
      margin-bottom: 2rem;
    }
    
    .contact-methods {
      margin-bottom: 2rem;
    }
    
    .contact-method {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: var(--q-surface);
      border-radius: var(--q-radius-md);
      border: 1px solid var(--q-border);
    }
    
    .method-icon {
      font-size: 1.5rem;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--q-brand-500);
      border-radius: var(--q-radius-sm);
      color: var(--q-ink);
    }
    
    .method-content h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
      color: #E8EAED;
    }
    
    .method-link {
      color: var(--q-brand-500);
      text-decoration: none;
      transition: color 0.2s;
    }
    
    .method-link:hover {
      color: var(--q-brand-600);
    }
    
    .availability h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .availability p {
      margin-bottom: 1rem;
    }
    
    .availability-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #A0A0A0;
    }
    
    .status-indicator {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }
    
    .status-indicator.available {
      background: var(--q-success);
    }
    
    /* FAQ */
    .faq {
      padding: 4rem 0;
      background: var(--q-surface);
    }
    
    .faq h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 3rem;
      color: #E8EAED;
      text-align: center;
    }
    
    .faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 2rem;
    }
    
    .faq-item {
      background: var(--q-bg);
      padding: 2rem;
      border-radius: var(--q-radius-lg);
      border: 1px solid var(--q-border);
    }
    
    .faq-item h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #E8EAED;
    }
    
    .faq-item p {
      color: #A0A0A0;
      line-height: 1.6;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2rem;
      }
      
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      
      .faq-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
