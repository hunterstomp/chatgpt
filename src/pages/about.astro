    font-weight: 600;
    margin-bottom: 15px;
    color: #2c3e50;
  }

  .about-content p {
    font-size: 1.1rem;
    margin-bottom: 20px;
    color: #555;
  }

  /* Skills Grid */
  .skills-intro {
    text-align: center;
    font-size: 1.2rem;
    margin-bottom: 50px;
    color: #666;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .skill-item {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .skill-item:hover {
    transform: translateY(-5px);
  }

  .skill-item h4 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: #2c3e50;
  }

  .skill-item p {
    color: #666;
