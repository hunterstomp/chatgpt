---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTransitions from '../../components/PageTransitions.astro';
import { absUrl } from "@/lib/absUrl";

const items = (await Astro.glob('./*.md*')).map(p => {
  const fm = p.frontmatter ?? {};
  const first = Array.isArray(fm.gallery) && fm.gallery[0]?.src;
  return {
    ...fm,
    href: `/case-studies/${fm.slug || p.file.replace(/\.mdx?$/,'')}/`,
    thumb: absUrl(fm.thumb || first),
  };
});
---

<BaseLayout
  title="Case Studies | Q10UX Portfolio"
  description="Explore a selection of enterprise UX case studies from Disney, AT&T, AtmosFX, and Microsoft, showcasing impactful design solutions."
>
  <PageTransitions />
  
  <!-- Enhanced Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">Case Studies</h1>
        <p class="hero-subtitle">
          A selection of impactful UX projects across enterprise, consumer, and emerging technologies
        </p>
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-number">{items.length}</div>
            <div class="stat-label">Case Studies</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">15+</div>
            <div class="stat-label">Years Experience</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Case Studies Section -->
  <section class="case-studies-section">
    <div class="container">
      <!-- Mobile Dropdown for Case Studies -->
      <div class="mobile-dropdown mobile-only">
        <button class="mobile-dropdown-toggle" id="caseStudiesToggle">
          <span class="dropdown-text">Select a Case Study</span>
          <span class="dropdown-arrow">▼</span>
        </button>
        
        <div class="mobile-dropdown-content" id="caseStudiesContent">
          <div class="mobile-case-studies-list">
            {items.map((item, index) => (
              <a href={item.href} class="mobile-case-study-item" data-index={index}>
                <div class="mobile-case-study-image">
                  <img 
                    src={item.thumb || '/assets/placeholders/case-study-placeholder.svg'} 
                    alt={item.title || 'Case Study'} 
                    loading="lazy"
                  />
                </div>
                <div class="mobile-case-study-info">
                  <div class="mobile-case-study-client">{item.client || 'Client'}</div>
                  <h3 class="mobile-case-study-title">{item.title || 'Case Study'}</h3>
                  <p class="mobile-case-study-summary">{item.summary || ''}</p>
                  {Array.isArray(item.tags) && item.tags.length > 0 && (
                    <div class="mobile-case-study-tags">
                      {item.tags.slice(0, 2).map(tag => (
                        <span class="mobile-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="mobile-case-study-arrow">→</div>
              </a>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Enhanced Desktop Grid -->
      <div class="case-studies-grid desktop-only">
        {items.map(item => (
          <a href={item.href} class="case-study-card">
            <div class="case-study-image">
              <img 
                src={item.thumb || '/assets/placeholders/case-study-placeholder.svg'} 
                alt={item.title || 'Case Study'} 
                loading="lazy"
              />
              <div class="case-study-overlay">
                <span class="view-case-study">View Case Study</span>
              </div>
            </div>
            <div class="case-study-content">
              <div class="case-study-client">{item.client || 'Client'}</div>
              <h3 class="case-study-title">{item.title || 'Case Study'}</h3>
              <p class="case-study-summary">{item.summary || ''}</p>
              {Array.isArray(item.tags) && item.tags.length > 0 && (
                <div class="case-study-tags">
                  {item.tags.slice(0, 3).map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Enhanced Contact CTA Section -->
  <section class="contact-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="section-title">Ready to Work Together?</h2>
        <p class="section-subtitle">Let's discuss how we can transform your user experience challenges into opportunities</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn--primary">Get In Touch</a>
          <a href="/about" class="btn btn--secondary">About Me</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Mobile dropdown functionality
    document.addEventListener('DOMContentLoaded', function() {
      const toggle = document.getElementById('caseStudiesToggle');
      const content = document.getElementById('caseStudiesContent');
      
      if (toggle && content) {
        toggle.addEventListener('click', function() {
          content.style.display = content.style.display === 'block' ? 'none' : 'block';
          toggle.classList.toggle('active');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
          if (!toggle.contains(event.target) && !content.contains(event.target)) {
            content.style.display = 'none';
            toggle.classList.remove('active');
          }
        });
      }
    });
  </script>

  <style>
    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    /* Hero Section */
    .hero-section {
      min-height: 50vh;
      display: flex;
      align-items: center;
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      color: white;
    }
    
    .hero-content {
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      transform: translateY(-5vh);
    }
    
    .hero-title {
      font-size: clamp(3rem, 8vw, 5rem);
      font-weight: 700;
      margin-bottom: 1rem;
      color: #ffffff;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
      letter-spacing: -0.02em;
    }
    
    .hero-subtitle {
      font-size: 1.25rem;
      color: #cccccc;
      line-height: 1.6;
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
    }
    
    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-top: 2rem;
    }
    
    .stat-item {
      text-align: center;
    }
    
    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #00E5FF;
      margin-bottom: 0.5rem;
    }
    
    .stat-label {
      font-size: 0.875rem;
      color: #cccccc;
    }
    
    /* Mobile Dropdown Styles */
    .mobile-dropdown {
      display: none; /* Hidden by default on desktop */
      width: 100%;
      padding: 1.5rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      border-radius: 12px;
      color: white;
      font-size: 1.25rem;
      font-weight: 600;
      cursor: pointer;
      margin-bottom: 1rem;
      transition: all 0.3s ease;
    }
    
    .mobile-dropdown:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
    }
    
    .mobile-dropdown-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 1.5rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      border-radius: 12px;
      color: white;
      font-size: 1.25rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .mobile-dropdown-toggle:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
    }
    
    .mobile-dropdown-content {
      display: none;
      flex-direction: column;
      gap: 1rem;
      margin-top: 0.5rem;
      background: #1a1a1a; /* Dark background for better contrast */
      border: 1px solid #333333;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    }
    
    .mobile-dropdown-content.active {
      display: flex;
    }
    
    .mobile-case-study-item {
      display: flex;
      align-items: center;
      background: #1a1a1a; /* Dark background for better contrast */
      border: 1px solid #333333;
      border-radius: 12px;
      padding: 1.5rem;
      text-decoration: none;
      color: #ffffff; /* White text for accessibility */
      transition: all 0.3s ease;
      min-height: 120px;
    }
    
    .mobile-case-study-item:hover {
      background: rgba(0, 229, 255, 0.1);
      border-color: #00E5FF;
      transform: translateX(8px);
      box-shadow: 0 4px 16px rgba(0, 229, 255, 0.2);
    }
    
    .mobile-case-study-image {
      width: 80px;
      height: 80px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      margin-right: 1rem;
      background: #2a2a2a; /* Loading state background */
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .mobile-case-study-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .mobile-case-study-image::before {
      content: '';
      width: 40px;
      height: 40px;
      border: 3px solid #333333;
      border-top: 3px solid #00E5FF;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .mobile-case-study-info {
      flex: 1;
      min-width: 0;
    }
    
    .mobile-case-study-client {
      font-size: 0.875rem;
      color: #00E5FF; /* Accent color for better visibility */
      font-weight: 600;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .mobile-case-study-title {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: #ffffff; /* White text for accessibility */
      line-height: 1.3;
    }
    
    .mobile-case-study-summary {
      font-size: 0.875rem;
      color: #cccccc; /* Light gray for better contrast */
      line-height: 1.4;
      margin-bottom: 0.75rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .mobile-case-study-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .mobile-tag {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      background: rgba(0, 229, 255, 0.1);
      color: #00E5FF;
      border-radius: 12px;
      font-weight: 500;
      border: 1px solid rgba(0, 229, 255, 0.2);
    }
    
    .mobile-case-study-arrow {
      font-size: 1.5rem;
      color: #00E5FF;
      margin-left: 1rem;
      transition: transform 0.3s ease;
    }
    
    .mobile-case-study-item:hover .mobile-case-study-arrow {
      transform: translateX(4px);
    }
    
    /* Desktop Grid (Hidden on Mobile) */
    .desktop-only {
      display: block;
    }
    
    /* Case Studies Section - Updated for Accessibility */
    .case-studies-section {
      padding: 6rem 0;
      background: #0a0a0a; /* Dark background */
    }
    
    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 2rem;
    }
    
    .case-study-card {
      background: #1a1a1a; /* Dark background for better contrast */
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0,0,0,0.3);
      text-decoration: none;
      color: #ffffff; /* White text for accessibility */
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 1px solid #333333;
      position: relative;
    }
    
    .case-study-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.4);
      border-color: #00E5FF;
    }
    
    .case-study-image {
      height: 250px;
      overflow: hidden;
      background: #2a2a2a; /* Loading state background */
      position: relative;
    }
    
    .case-study-image::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 40px;
      height: 40px;
      border: 3px solid #333333;
      border-top: 3px solid #00E5FF;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    
    .case-study-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: relative;
      z-index: 1;
    }

    .case-study-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 2;
    }

    .case-study-card:hover .case-study-overlay {
      opacity: 1;
    }

    .view-case-study {
      font-size: 1.25rem;
      font-weight: 600;
      color: white;
      background: #00E5FF;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      border: 2px solid #00E5FF;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .view-case-study:hover {
      background: transparent;
      color: #00E5FF;
      border-color: #00E5FF;
    }
    
    .case-study-content {
      padding: 2rem;
    }
    
    .case-study-client {
      font-size: 0.875rem;
      color: #00E5FF; /* Accent color for better visibility */
      margin-bottom: 0.5rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .case-study-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: #ffffff; /* White text for accessibility */
      line-height: 1.3;
    }
    
    .case-study-summary {
      font-size: 1rem;
      color: #cccccc; /* Light gray for better contrast */
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    
    .case-study-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .tag {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      background: rgba(0, 229, 255, 0.1);
      color: #00E5FF;
      border-radius: 12px;
      font-weight: 500;
      border: 1px solid rgba(0, 229, 255, 0.2);
    }
    
    /* CTA Section */
    .contact-cta {
      padding: 6rem 0;
      background: #1a1a1a;
      color: white;
      text-align: center;
    }
    
    .cta-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .section-subtitle {
      font-size: 1.125rem;
      color: #cccccc;
      margin-bottom: 2rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .btn {
      display: inline-block;
      padding: 1rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      border: 2px solid transparent;
    }
    
    .btn--primary {
      background: #007bff;
      color: white;
    }
    
    .btn--primary:hover {
      background: #0056b3;
      transform: translateY(-2px);
    }
    
    .btn--secondary {
      background: transparent;
      color: white;
      border-color: white;
    }
    
    .btn--secondary:hover {
      background: white;
      color: #1a1a1a;
      transform: translateY(-2px);
    }
    
    /* Mobile Responsive */
    @media (max-width: 768px) {
      .container {
        padding: 0 1rem;
      }
      
      .hero-title {
        font-size: 2.5rem;
      }
      
      .hero-subtitle {
        font-size: 1rem;
        font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      .hero-stats {
        flex-direction: column;
        gap: 1rem;
      }

      .stat-number {
        font-size: 2rem;
      }

      .stat-label {
        font-size: 0.75rem;
      }
      
      .case-studies-section {
        padding: 3rem 0;
      }
      
      .mobile-dropdown {
        display: block; /* Show on mobile */
      }
      
      .desktop-only {
        display: none;
      }
      
      .mobile-case-study-item {
        min-height: 140px; /* Larger touch target on mobile */
      }
      
      .mobile-case-study-image {
        width: 100px;
        height: 100px;
      }
      
      .mobile-case-study-title {
        font-size: 1.25rem;
      }
      
      .mobile-case-study-summary {
        font-size: 1rem;
      }
    }
    
    /* Tablet Responsive */
    @media (min-width: 769px) and (max-width: 1024px) {
      .case-studies-grid {
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      }
      
      .case-study-content {
        padding: 1.5rem;
      }
      
      .case-study-title {
        font-size: 1.25rem;
      }
    }
  </style>
</BaseLayout>
