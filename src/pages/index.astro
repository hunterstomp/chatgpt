            <img src="/assets/logos/TMOBILELOGO.svg" alt="T-Mobile" class="client-logo" loading="lazy">
          </div>
          
          <!-- Office 365 -->
          <div class="carousel-item">
            <img src="/assets/logos/OFFICE365LOGO.svg" alt="Office 365" class="client-logo" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UX Designer Section -->
  <section class="ux-designer-section">
    <div class="container">
      <div class="ux-content">
        <div class="ux-text">
          <h2 class="section-title">Enterprise UX Designer</h2>
          <p class="section-subtitle">
            Specializing in accessibility, design systems, and user research. 
            I help organizations create digital experiences that are both beautiful and functional.
          </p>
          <div class="ux-features">
            <div class="feature-item">
              <h3>Accessibility First</h3>
              <p>Ensuring digital products work for everyone, regardless of ability.</p>
            </div>
            <div class="feature-item">
              <h3>Design Systems</h3>
              <p>Creating scalable, consistent design foundations for large organizations.</p>
            </div>
            <div class="feature-item">
              <h3>User Research</h3>
              <p>Data-driven insights to inform design decisions and improve user experience.</p>
            </div>
          </div>
        </div>
        <div class="ux-image">
          <img src="/assets/images/hero-tmobile2-975x1363.webp" alt="UX Design Process" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Highlights Section -->
  <section class="portfolio-highlights">
    <div class="container">
      <div class="portfolio-header">
        <h2 class="section-title">Featured Case Studies</h2>
        <p class="section-subtitle">Explore detailed case studies showcasing my approach to complex UX challenges</p>
      </div>
      <div class="portfolio-grid">
        <div class="portfolio-card">
          <div class="card-image">
            <img src="/assets/images/hero-o365-1034x1421.jpg" alt="Office 365 Case Study" loading="lazy">
          </div>
          <div class="card-content">
            <h3>Office 365 Redesign</h3>
            <p>Modernizing the productivity suite for millions of users worldwide.</p>
            <a href="/case-studies/office-365" class="btn btn--primary">View Case Study</a>
          </div>
        </div>
        <div class="portfolio-card">
          <div class="card-image">
            <img src="/assets/images/hero-tmobile-howtoswitch-816x1121.webp" alt="T-Mobile Case Study" loading="lazy">
          </div>
          <div class="card-content">
            <h3>T-Mobile How to Switch</h3>
            <p>Simplifying the carrier switching process for new customers.</p>
            <a href="/case-studies/tmobile" class="btn btn--primary">View Case Study</a>
          </div>
        </div>
        <div class="portfolio-card">
          <div class="card-image">
            <img src="/assets/images/hero-olw-1034x1421.webp" alt="AtmosFX Case Study" loading="lazy">
          </div>
          <div class="card-content">
            <h3>AtmosFX Halloween</h3>
            <p>Creating immersive digital experiences for seasonal entertainment.</p>
            <a href="/case-studies/atmosfx" class="btn btn--primary">View Case Study</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA Section -->
  <section class="contact-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="section-title">Ready to Create Something Amazing?</h2>
        <p class="section-subtitle">
          Let's work together to build digital experiences that make a difference.
        </p>
        <div class="cta-buttons">
          <a href="/case-studies" class="btn btn--primary">View All Case Studies</a>
          <a href="/contact" class="btn btn--secondary">Get In Touch</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Hero Content Styles */
    .hero-content {
      position: relative;
      z-index: 3;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      max-width: 100%;
      margin: 0 auto;
      padding: 0 2rem;
      min-height: 80vh;
      transform: translateY(-8vh);
    }

    .hero-text-content {
      max-width: 90vw;
      width: 100%;
    }

    .hero-title {
      font-size: clamp(4rem, 12vw, 8rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 2rem;
      color: #ffffff;
      text-align: center;
      text-shadow: 0 6px 12px rgba(0, 0, 0, 0.8);
    }

    [data-theme="light"] .hero-title {
      color: #1a1a1a;
      text-shadow: 0 6px 12px rgba(255, 255, 255, 0.8);
    }

    .hero-title-main {
      display: block;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    .hero-title-sub {
      display: block;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
      letter-spacing: -0.02em;
      color: var(--accent-1);
    }

    .hero-subtitle {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      line-height: 1.4;
      color: #ffffff;
      margin-bottom: 3rem;
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
      max-width: 80vw;
      margin-left: auto;
      margin-right: auto;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      text-shadow: 0 4px 8px rgba(0, 0, 0, 0.7);
    }

    [data-theme="light"] .hero-subtitle {
      color: #1a1a1a;
      text-shadow: 0 4px 8px rgba(255, 255, 255, 0.7);
    }

    .hero-line-1 {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-weight: 100;
      font-size: 36px;
      font-style: normal;
      letter-spacing: -0.02em;
      color: #ffffff;
      text-transform: none;
      text-shadow: 0 4px 8px rgba(0, 0, 0, 0.7);
    }

    [data-theme="light"] .hero-line-1 {
      color: #1a1a1a;
      text-shadow: 0 4px 8px rgba(255, 255, 255, 0.7);
    }

    .hero-line-2 {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-weight: 100;
      font-size: 28px;
      font-style: normal;
      color: #ffffff;
      text-transform: none;
      letter-spacing: 0;
      text-shadow: 0 4px 8px rgba(0, 0, 0, 0.7);
    }

    [data-theme="light"] .hero-line-2 {
      color: #1a1a1a;
      text-shadow: 0 4px 8px rgba(255, 255, 255, 0.7);
    }

    .hero-cta {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* Hero Stats Section */
    .hero-stats {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 2rem;
      background: rgba(20, 20, 20, 0.8);
      backdrop-filter: blur(20px);
      border-radius: var(--radius);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat-item {
      text-align: center;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--accent-1);
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
      line-height: 1;
    }

    .stat-label {
      font-size: 0.875rem;
      color: #cccccc;
      margin-top: 0.5rem;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
    }

    /* Enhanced Client Logos Section */
    .clients-section {
      padding: 6rem 0;
      background: var(--surface);
    }

    .clients-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      margin-bottom: 1rem;
      color: #ffffff;
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
      letter-spacing: -0.02em;
    }

    .section-subtitle {
      font-size: 1.125rem;
      color: #cccccc;
      max-width: 600px;
      margin: 0 auto;
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      text-transform: none;
    }

    /* Logo Carousel Styles */
    .logo-carousel-wrapper {
      position: relative;
      z-index: 2;
      margin-top: 2rem;
    }

    .logo-carousel-wrapper .carousel-container {
      max-width: 100%;
      overflow: hidden;
      position: relative;
    }

    .logo-carousel-wrapper .carousel-track {
      display: flex;
      animation: logo-scroll 30s linear infinite;
      width: calc(200px * 12);
    }

    .logo-carousel-wrapper .carousel-item {
      flex: 0 0 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 2rem;
      height: 100px;
    }

    .logo-carousel-wrapper .client-logo {
      max-width: 140px;
      max-height: 60px;
      width: auto;
      height: auto;
      filter: grayscale(100%) brightness(0.7);
      transition: all 0.3s ease;
      opacity: 0.8;
    }

    .logo-carousel-wrapper .client-logo:hover {
      filter: grayscale(0%) brightness(1);
      opacity: 1;
      transform: scale(1.05);
    }

    @keyframes logo-scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-200px * 6));
      }
    }

    /* Pause animation on hover */
    .logo-carousel-wrapper .carousel-container:hover .carousel-track {
      animation-play-state: paused;
    }

    /* Enhanced UX Designer Section */
    .ux-designer-section {
      padding: 6rem 0;
