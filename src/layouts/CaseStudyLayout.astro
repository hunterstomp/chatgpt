---
import ReadingProgress from "@/components/ReadingProgress.astro";
import Reveal from "@/components/Reveal.astro";
let { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title ?? "Case Study"}</title>
    <meta name="description" content={frontmatter.summary ?? "UX case study"} />
  </head>
  <body class="bg-neutral-950 text-neutral-100">
    <ReadingProgress />
    <main class="mx-auto max-w-7xl px-6 py-10 grid gap-10 md:grid-cols-[minmax(16rem,20rem),1fr]">
      <aside class="md:sticky md:top-24 md:max-h-[75vh] md:overflow-auto space-y-5">
        <h1 class="text-2xl font-semibold leading-tight">{frontmatter.title}</h1>
        <div class="grid gap-2 text-sm">
          <div><span class="text-neutral-400">Client</span><div>{frontmatter.client}</div></div>
          <div><span class="text-neutral-400">Role</span><div>{frontmatter.role}</div></div>
          <div><span class="text-neutral-400">Year</span><div>{frontmatter.year}</div></div>
          {frontmatter.kpi && <div><span class="text-neutral-400">Outcome</span><div>{frontmatter.kpi}</div></div>}
          {Array.isArray(frontmatter.tags) && frontmatter.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {frontmatter.tags.map(t => <span class="rounded-full bg-white/10 px-3 py-1 text-xs">{t}</span>)}
            </div>
          )}
        </div>
        {frontmatter.summary && <p class="text-neutral-300 pt-4 text-sm leading-relaxed">{frontmatter.summary}</p>}
      </aside>

      <section class="min-w-0">
        {Array.isArray(frontmatter.gallery) && frontmatter.gallery.length > 0 && (
          <>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {frontmatter.gallery.slice(0,9).map(g => {
                const src = typeof g === 'string' ? g : g?.src || '';
                const alt = typeof g === 'string' ? '' : g?.alt || '';
                const caption = typeof g === 'string' ? '' : g?.caption || '';
                
                // Fix image paths that start with /../
                const imageSrc = src.startsWith('/../') ? src.replace('/../', '/') : src;
                
                return (
                  <a href={imageSrc} class="group block overflow-hidden rounded-xl bg-white/5">
                    <img 
                      src={imageSrc} 
                      alt={alt} 
                      loading="lazy" 
                      decoding="async" 
                      class="aspect-[4/3] w-full object-cover group-hover:scale-[1.02] transition" 
                    />
                  </a>
                );
              })}
            </div>
            <hr class="border-white/10 my-8" />
          </>
        )}

        <Reveal as="div" class="prose prose-invert max-w-none">
          <slot />
        </Reveal>

        {Array.isArray(frontmatter.outcomes) && frontmatter.outcomes.length > 0 && (
          <div class="mt-10">
            <h2 class="text-xl font-semibold mb-3">Key Takeaways</h2>
            <ul class="list-disc pl-5 space-y-2 text-neutral-300">
              {frontmatter.outcomes.map(o => <li>{o}</li>)}
            </ul>
          </div>
        )}
      </section>
    </main>
  </body>
</html>
