---
// Get all case studies and filter for published ones
const caseStudies = await Astro.glob('/src/pages/case-studies/*.md');
const publishedStudies = caseStudies
  .filter(study => study.frontmatter.status === 'published')
  .slice(0, 3);

// If no published studies, show some default ones
const featuredStudies = publishedStudies.length > 0 
  ? publishedStudies 
  : caseStudies.slice(0, 3);
---

<section class="py-16 bg-neutral-900">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center">
      Featured Work
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredStudies.map(study => {
        const slug = study.file.split('/').pop()?.replace('.md', '') || '';
        const title = study.frontmatter.title || 'Case Study';
        const client = study.frontmatter.client || 'Client';
        const tags = Array.isArray(study.frontmatter.tags) ? study.frontmatter.tags : [];
        const gallery = Array.isArray(study.frontmatter.gallery) ? study.frontmatter.gallery : [];
        const thumbnail = gallery.length > 0 
          ? (typeof gallery[0] === 'string' ? gallery[0] : gallery[0]?.src || '')
          : '/assets/images/placeholder.jpg';
        
        // Fix image paths
        const imageSrc = thumbnail.startsWith('/../') ? thumbnail.replace('/../', '/') : thumbnail;
        
        return (
          <a 
            href={`/case-studies/${slug}`}
            class="group block bg-neutral-800 rounded-xl overflow-hidden hover:bg-neutral-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src={imageSrc} 
                alt={title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <p class="text-sm text-neutral-400 mb-2">{client}</p>
              <h3 class="text-xl font-semibold text-white mb-3 group-hover:text-blue-400 transition-colors">
                {title}
              </h3>
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {tags.slice(0, 3).map(tag => (
                    <span class="text-xs bg-neutral-700 text-neutral-300 px-2 py-1 rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
    
    <div class="text-center mt-12">
      <a 
        href="/case-studies" 
        class="inline-flex items-center text-blue-400 hover:text-blue-300 font-semibold group"
      >
        View All Case Studies
        <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </div>
</section>
