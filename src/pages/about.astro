  }

  .hero-subtitle {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 40px;
    opacity: 0.9;
  }

  .hero-nav {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .nav-link {
    color: white;
    text-decoration: none;
    padding: 12px 24px;
    border: 2px solid white;
    border-radius: 30px;
    transition: all 0.3s ease;
    font-weight: 500;
  }

  .nav-link:hover {
    background: white;
    color: #667eea;
  }

  /* Section Styles */
  .about-me-section,
  .skills-section,
  .highlights-section,
  .clients-section,
  .testimonials-section,
  .ai-generations-section,
  .contact-section,
