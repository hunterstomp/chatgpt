---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTransitions from '../../components/PageTransitions.astro';
import ReadingProgress from "../../components/ReadingProgress.astro";
---

<BaseLayout
  title="Case Studies - Q10UX.com - UX Portfolio of Quentin Little"
  description="Explore comprehensive UX case studies showcasing user-centered design solutions for leading brands including AtmosFX, T-Mobile, Microsoft, AT&T, and more."
>
  <PageTransitions />
  <ReadingProgress />
  
  <!-- Hero Section -->
  <section class="q10ux-hero" style="background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/assets/backgrounds/atmosfx.webp'); background-size: cover; background-position: center;">
    <div class="container">
      <div class="row align-items-center min-vh-100">
        <div class="col-lg-8 mx-auto text-center">
          <!-- Centered Hero Image -->
          <div class="hero-image-container mb-4">
            <img src="/assets/backgrounds/atmosfx.webp" alt="UX Design Hero" class="hero-image" style="width: 200px; height: 200px; object-fit: cover; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
          </div>
          
          <h1 class="hero-title">Case Studies</h1>
          <p class="hero-subtitle">
            A selection of impactful UX projects across enterprise, consumer, and emerging technologies
          </p>
          
          <div class="hero-stats d-flex justify-content-center gap-5 mb-4">
            <div class="stat-item text-center">
              <div class="stat-number">9</div>
              <div class="stat-label">Case Studies</div>
            </div>
            <div class="stat-item text-center">
              <div class="stat-number">15+</div>
              <div class="stat-label">Years Experience</div>
            </div>
          </div>
          
          <div class="d-flex gap-3 flex-wrap justify-content-center">
            <a href="#case-studies" class="btn btn-primary btn-lg">Explore Case Studies</a>
            <a href="/contact" class="btn btn-outline-light btn-lg">Get in Touch</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Case Studies Grid -->
  <section class="section" id="case-studies">
    <div class="container">
      <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
          <h2>Featured Case Studies</h2>
          <p class="lead">
            Each case study demonstrates the complete UX design process from research to implementation, 
            showcasing how user-centered design drives business results.
          </p>
        </div>
      </div>
      
      <div class="case-studies-grid">
        <!-- AtmosFX Media Player -->
        <div class="case-study-card">
          <div class="portfolio-card">
            <a href="/case-studies/atmos-fx-e-commerce-redesign-q-10-ux-portfolio" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/atmosfx.webp" alt="AtmosFX Media Player - Digital media playback interface design" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-AFXg.webp" alt="AtmosFX Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>AtmosFX Media Player</strong>
                </h5>
                <p class="portfolio-description">
                  Digital media playback interface design for immersive entertainment experiences.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Media Player</span>
                  <span class="tag">Entertainment</span>
                  <span class="tag">Interface Design</span>
                  <span class="tag">User Experience</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- T-Mobile How to Switch -->
        <div class="case-study-card">
          <div class="portfolio-card">
            <a href="/case-studies/t-mobile-how-to-switch" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/tmobile-purchase.webp" alt="T-Mobile How to Switch - Carrier switching experience design" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-TMOMagenta.webp" alt="T-Mobile Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>T-Mobile How to Switch</strong>
                </h5>
                <p class="portfolio-description">
                  Streamlined carrier switching experience for mobile customers.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Mobile UX</span>
                  <span class="tag">Carrier Switching</span>
                  <span class="tag">User Journey</span>
                  <span class="tag">Process Design</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- AT&T International Roaming -->
        <div class="case-study-card">
          <div class="portfolio-card">
            <a href="/case-studies/at-amp-t-international-roaming-q-10-ux-portfolio" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/att.webp" alt="AT&T International Roaming - Mobile app interface for international travel" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-ATTBlue.webp" alt="AT&T Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>AT&T International Roaming</strong>
                </h5>
                <p class="portfolio-description">
                  Mobile app interface for international travel data plans and border crossing fees.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Mobile UX</span>
                  <span class="tag">International</span>
                  <span class="tag">Payment Flow</span>
                  <span class="tag">Travel</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- AtmosFX E-commerce -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="portfolio-card">
            <a href="/case-studies/atmos-fx-e-commerce-redesign-q-10-ux-portfolio" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/atmosfx.webp" alt="AtmosFX E-commerce - Online shopping experience redesign" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-AFXg.webp" alt="AtmosFX Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>AtmosFX E-commerce</strong>
                </h5>
                <p class="portfolio-description">
                  Redesigned online shopping experience for digital entertainment products.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">E-commerce</span>
                  <span class="tag">Shopping Experience</span>
                  <span class="tag">Digital Products</span>
                  <span class="tag">Conversion</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- Bill & Melinda Gates Foundation -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="portfolio-card">
            <a href="/case-studies/bill-and-melinda-gates-foundation" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/gates.webp" alt="Bill & Melinda Gates Foundation - Healthcare and education initiatives" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-BMGF-wht.webp" alt="BMGF Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>Bill & Melinda Gates Foundation</strong>
                </h5>
                <p class="portfolio-description">
                  Healthcare and education initiatives for global impact and accessibility.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Healthcare</span>
                  <span class="tag">Education</span>
                  <span class="tag">Global Impact</span>
                  <span class="tag">Accessibility</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- Microsoft Office 365 -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="portfolio-card">
            <a href="/case-studies/microsoft-office-365-q-10-ux-portfolio" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/O365.webp" alt="Microsoft Office 365 - Cloud-based productivity suite" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-MSFT.webp" alt="Microsoft Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>Microsoft Office 365</strong>
                </h5>
                <p class="portfolio-description">
                  Cloud-based productivity suite for modern workplace collaboration.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Productivity</span>
                  <span class="tag">Cloud Services</span>
                  <span class="tag">Collaboration</span>
                  <span class="tag">Enterprise</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- Office Live Workspaces -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="portfolio-card">
            <a href="/case-studies/microsoft-office-live-q-10-ux-portfolio" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/officelive.webp" alt="Office Live Workspaces - Future vision for social collaboration" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-MSFT.webp" alt="Microsoft Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>Office Live Workspaces</strong>
                </h5>
                <p class="portfolio-description">
                  Future vision for social collaboration with WYSIWYG site builder capabilities.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Site Builder</span>
                  <span class="tag">WYSIWYG</span>
                  <span class="tag">File Locker</span>
                  <span class="tag">Office Integration</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
        
        <!-- T-Mobile Idea Lab -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="portfolio-card">
            <a href="/case-studies/t-mobile-idea-lab-q-10-ux-portfolio" class="portfolio-link">
              <div class="portfolio-image">
                <img src="/assets/backgrounds/tmobile-labs.webp" alt="T-Mobile Idea Lab - Innovation and prototyping platform" loading="lazy" onerror="console.log('Image failed to load:', this.src);" onload="console.log('Image loaded successfully:', this.src);">
                <div class="logo-overlay">
                  <img src="/assets/logos/CircleLogo-TMOMagenta.webp" alt="T-Mobile Logo" loading="lazy" onerror="console.log('Logo failed to load:', this.src);" onload="console.log('Logo loaded successfully:', this.src);">
                </div>
              </div>
              <div class="portfolio-content">
                <h5 class="portfolio-title">
                  <strong>T-Mobile Idea Lab</strong>
                </h5>
                <p class="portfolio-description">
                  Innovation and prototyping platform for testing new mobile experiences.
                </p>
                <div class="portfolio-tags">
                  <span class="tag">Innovation</span>
                  <span class="tag">Prototyping</span>
                  <span class="tag">Mobile UX</span>
                  <span class="tag">Testing</span>
                </div>
                <div class="portfolio-button">
                  <span class="btn btn-primary btn-sm text-uppercase fw-bold">VIEW CASE STUDY</span>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="section bg-dark" id="cta">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto text-center">
          <h2>Ready to Create Amazing User Experiences?</h2>
          <p class="lead mb-4">
            Let's discuss how we can work together to design user-centered solutions that drive business results.
          </p>
          <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/contact" class="btn btn-lg">Get in Touch</a>
            <a href="/about" class="btn btn-secondary btn-lg">Learn More About Me</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Bootstrap Grid System */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }
    
    .row {
      display: flex;
      flex-wrap: wrap;
      margin: 0 -0.5rem;
    }
    
    .col-12, .col-md-6, .col-lg-4, .col-lg-8 {
      padding: 0 0.5rem;
    }
    
    .col-12 { flex: 0 0 100%; }
    .col-md-6 { flex: 0 0 50%; }
    .col-lg-4 { flex: 0 0 33.333333%; }
    .col-lg-8 { flex: 0 0 66.666667%; }
    
    @media (max-width: 768px) {
      .col-md-6 { flex: 0 0 100%; }
    }
    
    @media (max-width: 992px) {
      .col-lg-4, .col-lg-8 { flex: 0 0 100%; }
    }
    
    /* Utility Classes */
    .d-flex { display: flex; }
    .gap-3 { gap: 1rem; }
    .flex-wrap { flex-wrap: wrap; }
    .justify-content-center { justify-content: center; }
    .align-items-center { align-items: center; }
    .text-center { text-align: center; }
    .mb-4 { margin-bottom: 1.5rem; }
    .mb-5 { margin-bottom: 3rem; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    .min-vh-100 { min-height: 100vh; }
    .g-4 { gap: 1.5rem; }
    
    /* Hero Section */
    .q10ux-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      overflow: hidden;
    }
    
    .q10ux-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(45deg, rgba(102, 126, 234, 0.8), rgba(118, 75, 162, 0.8), rgba(255, 94, 77, 0.8), rgba(255, 154, 0, 0.8));
      background-size: 400% 400%;
      animation: gradientShift 8s ease infinite;
      z-index: 1;
    }
    
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    
    .q10ux-hero .container {
      position: relative;
      z-index: 2;
    }
    
    .hero-image-container {
      animation: float 6s ease-in-out infinite;
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }
    
    .hero-image {
      border: 4px solid rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }
    
    .hero-image:hover {
      transform: scale(1.05);
      border-color: rgba(255, 255, 255, 0.8);
      box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }
    
    .hero-title {
      font-size: 4rem;
      font-weight: 700;
      color: white;
      text-shadow: 0 4px 8px rgba(0,0,0,0.3);
      margin-bottom: 1rem;
      animation: slideInUp 1s ease-out;
    }
    
    .hero-subtitle {
      font-size: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 2rem;
      animation: slideInUp 1s ease-out 0.2s both;
    }
    
    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .hero-stats {
      animation: slideInUp 1s ease-out 0.4s both;
    }
    
    .stat-item {
      padding: 1rem;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 15px;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s ease;
    }
    
    .stat-item:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-5px);
    }
    
    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #00e5ff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    
    .stat-label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.8);
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    .btn-primary {
      background: linear-gradient(135deg, #00e5ff 0%, #00bcd4 100%);
      border: none;
      color: white;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 1rem 2rem;
      border-radius: 50px;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(0, 229, 255, 0.3);
    }
    
    .btn-primary:hover {
      background: linear-gradient(135deg, #00bcd4 0%, #0097a7 100%);
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(0, 229, 255, 0.4);
      color: white;
    }
    
    .btn-outline-light {
      background: rgba(255, 255, 255, 0.1);
      border: 2px solid rgba(255, 255, 255, 0.3);
      color: white;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 1rem 2rem;
      border-radius: 50px;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
    }
    
    .btn-outline-light:hover {
      background: rgba(255, 255, 255, 0.2);
      border-color: rgba(255, 255, 255, 0.8);
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(255, 255, 255, 0.2);
      color: white;
    }
    
    /* Section */
    .section {
      padding: 4rem 0;
    }
    
    .bg-dark {
      background: var(--bg);
      color: var(--text);
    }
    
    /* Portfolio Cards */
    .portfolio-card {
      background: var(--surface);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease;
      height: 100%;
    }
    
    .portfolio-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
    }
    
    .portfolio-link {
      text-decoration: none;
      color: inherit;
      display: block;
      height: 100%;
    }
    
    .portfolio-image {
      position: relative;
      height: 200px;
      overflow: hidden;
    }
    
    .portfolio-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    
    .portfolio-card:hover .portfolio-image img {
      transform: scale(1.05);
    }
    
    .logo-overlay {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      overflow: hidden;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .logo-overlay img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }
    
    .portfolio-content {
      padding: 1.5rem;
    }
    
    .portfolio-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    
    .portfolio-description {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      line-height: 1.5;
    }
    
    .portfolio-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    
    .tag {
      background: var(--muted);
      color: var(--text);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
    }
    
    .portfolio-button {
      text-align: center;
    }
    
    /* Responsive Grid Layout */
    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }
    
    .case-study-card {
      display: flex;
      flex-direction: column;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .section {
        padding: 2rem 0;
      }
      
      .q10ux-hero h1 {
        font-size: 2rem;
      }
      
      .q10ux-hero .lead {
        font-size: 1rem;
      }
      
      .portfolio-content {
        padding: 1rem;
      }
      
      .case-studies-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }
    
    @media (min-width: 769px) and (max-width: 1200px) {
      .case-studies-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }
    }
    
    @media (min-width: 1201px) {
      .case-studies-grid {
        grid-template-columns: repeat(3, 1fr);
